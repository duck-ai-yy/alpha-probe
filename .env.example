# ---------------------------------------------------------------
# Alpha-Probe environment
# Copy to .env and fill in. .env is gitignored.
# `bun run analyze` and `bun run install:dexter` will chmod 600 .env
# automatically. To do it yourself: chmod 600 .env
# ---------------------------------------------------------------

# --- LLM ---
# One LLM key is required. Anthropic recommended — prompt caching cuts
# cost meaningfully on a 200k-token agent loop.
#
# PRIVACY: whichever LLM provider you set will see every prompt, every
# tool result that returns to the agent, and your final report. Pick one.
ANTHROPIC_API_KEY=

# Leave the following EMPTY unless you specifically want to use them.
# If OPENAI_API_KEY or GOOGLE_API_KEY are set, Dexter's memory subsystem
# uses them for embeddings — meaning OpenAI or Google sees chunks of every
# conversation. `bun run analyze` warns at startup if any of these are set.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# --- Financial data --- REQUIRED.
# Gates Bobby Steps 1, 4 (institutional + insider), 6 (SEC filings), 7 (news).
# PRIVACY: Financial Datasets sees every ticker query you make — they can
# profile your research interests over time.
# https://www.financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=

# --- Web search --- REQUIRED for Step 5 (Operational Front-Running).
# Dexter tries them in this order; set at least one.
# PRIVACY: the chosen search provider sees every query (which includes
# tickers and suspected event types — e.g. "IREN hyperscaler partnership").
EXASEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
LANGSEARCH_API_KEY=

# --- X/Twitter --- optional but recommended. Enables Step 5 sentiment
# and cashtag scans via x_search tool.
# PRIVACY: bearer-token query history is visible to X.
X_BEARER_TOKEN=

# --- LangSmith --- OFF by default. Setting TRACING=true ships every
# LLM call (full prompt + response) to LangSmith. analyze warns if true.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=alpha-probe
LANGSMITH_TRACING=false

# ---------------------------------------------------------------
# What is NOT covered by any of the above:
#   - Options / derivatives data (Bobby Steps 2-3).
#     Dexter has no options API at any tier.
#     Paste flow into .dexter/inputs/{ticker}/options.md per
#     .dexter/skills/major-partnership-insider/options-input-template.md
#
# Other hardening:
#   - `bun run install:hooks`  installs a pre-commit guard against
#     accidentally committing .env, options.md, or API-key-looking strings.
#   - `bun run analyze:clean`  wipes .dexter/memory and .dexter/cache
#     after the run so research history doesn't accumulate on disk.
#   - `bun run clean:traces`   the cleanup step on its own.
# ---------------------------------------------------------------
